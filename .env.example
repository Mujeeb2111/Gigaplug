# Admin login (seeded/hardcoded)
GIGAPLUG_ADMIN_EMAIL=admin@gigaplug.com
GIGAPLUG_ADMIN_PASSWORD=admin@123

# App
SESSION_SECRET=GIGAPLUG_SESSION_SECRET_REPLACE_IN_PRODUCTION_ENV
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Squad (payment/virtual accounts)
SQUAD_SECRET_KEY=sk_test_...
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
# For dedicated B2B virtual accounts, set the merchant BVN and GTBank account.
# This is the merchant's BVN, not a user-facing field.
SQUAD_BVN=12345678901
SQUAD_BVN_PHONE=08012345678
SQUAD_BENEFICIARY_ACCOUNT=0123456789

# 5sim (OTP numbers)
FIVESIM_API_KEY=your-5sim-api-key
FIVESIM_BASE_URL=https://5sim.net/v1
FIVESIM_FX_TO_NGN=1500

# ClubKonnect (data & airtime)
CLUBKONNECT_API_KEY=your-clubkonnect-api-key
CLUBKONNECT_USER_ID=your-clubkonnect-user-id
CLUBKONNECT_BASE_URL=https://www.nellobytesystems.com

# Brevo (transactional email)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@gigaplug.com
BREVO_SENDER_NAME=GigaPlug
